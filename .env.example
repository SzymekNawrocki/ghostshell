# Copy to .env and fill in real values. .env is gitignored — never commit it.

POSTGRES_USER=hacker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hackerrpg

# Used when running the app locally with `uvicorn` (outside docker-compose),
# where docker-compose's own DB service is reachable at localhost thanks to
# its `ports: 5432:5432` mapping.
DATABASE_URL=postgresql://hacker:changeme@localhost:5432/hackerrpg

# Path to the sherlock executable. Locally point this at its own venv, e.g.
# C:\Users\hp\tools\sherlock\.venv\Scripts\sherlock.exe — in the container
# "sherlock" is enough once it's installed on PATH there.
SHERLOCK_BIN=sherlock
